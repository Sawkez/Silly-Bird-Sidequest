FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git cmake ninja-build \
    libasound2-dev libfribidi-dev libpulse-dev libpipewire-0.3-dev \
    libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxfixes-dev \
    libxi-dev libdbus-1-dev libibus-1.0-dev \
    libsystemd-dev libgl1-mesa-dev libxkbcommon-dev libgles2-mesa-dev \
    libegl1-mesa-dev libvulkan-dev libwayland-dev wayland-protocols \
    libdrm-dev libgbm-dev libusb-1.0-0-dev libdecor-0-dev \
    libjack-jackd2-dev libthai-dev liburing-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*